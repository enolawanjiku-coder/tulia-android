rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // In a direct chat, the member who is not the sender.
    function recipientUid() {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.members[0] == request.auth.uid
             ? get(/databases/$(database)/documents/chats/$(chatId)).data.members[1]
             : get(/databases/$(database)/documents/chats/$(chatId)).data.members[0];
    }

    function isBlockedByRecipient() {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.members.size() == 2
             && request.auth.uid in get(/databases/$(database)/documents/users/$(recipientUid()))
                 .data.get('blocked', []);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && !exists(/databases/$(database)/documents/usernames/$(username));
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Device push tokens: only the owner can write their doc, nobody can read
    // it from a client. The media worker reads it with a service account.
    match /pushTokens/{userId} {
      allow read: if false;
      allow create, update: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.tokens is list
                    && request.resource.data.tokens.size() >= 1
                    && request.resource.data.tokens.size() <= 20;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Abuse reports. Writable by the reporter only, never readable from a
    // client; review them in the Firebase console.
    match /reports/{reportId} {
      allow read: if false;
      allow create: if signedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.reportedUid is string
                    && request.resource.data.reportedUid.size() >= 1
                    && request.resource.data.reportedUid.size() <= 128
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() <= 200;
      allow update, delete: if false;
    }

    match /chats/{chatId} {
      allow get: if signedIn()
                 && (resource == null || request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() == 2;
      allow update: if signedIn()
                    && request.auth.uid in resource.data.members
                    && request.resource.data.members == resource.data.members;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in
                    get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if signedIn()
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 4000
                      && (!('imageUrl' in request.resource.data)
                          || (request.resource.data.imageUrl is string
                              && request.resource.data.imageUrl.size() <= 2048))
                      && request.auth.uid in
                         get(/databases/$(database)/documents/chats/$(chatId)).data.members
                      && !isBlockedByRecipient();
        allow update: if signedIn()
                      && resource.data.senderId == request.auth.uid
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 4000
                      && (!('imageUrl' in request.resource.data)
                          || (request.resource.data.imageUrl is string
                              && request.resource.data.imageUrl.size() <= 2048));
        allow delete: if signedIn() && resource.data.senderId == request.auth.uid;

        match /reactions/{reactionId} {
          allow read: if signedIn() && request.auth.uid in
                      get(/databases/$(database)/documents/chats/$(chatId)).data.members;
          allow create, update: if signedIn()
                      && request.auth.uid in
                         get(/databases/$(database)/documents/chats/$(chatId)).data.members
                      && request.resource.data.type is string
                      && request.resource.data.type.size() <= 8;
          allow delete: if signedIn() && request.auth.uid in
                      get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
      }
    }
  }
}
