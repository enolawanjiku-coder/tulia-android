<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:gravity="end"
    android:orientation="horizontal"
    android:paddingStart="48dp"
    android:paddingEnd="0dp">

    <com.tulia.app.ui.widget.SentBubbleLayout
        android:id="@+id/sent_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/bubble_padding_h"
        android:paddingTop="@dimen/bubble_padding_v"
        android:paddingEnd="@dimen/bubble_padding_h"
        android:paddingBottom="7dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/quote_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_quote_sent"
                android:orientation="vertical"
                android:paddingStart="11dp"
                android:paddingTop="3dp"
                android:paddingEnd="11dp"
                android:paddingBottom="3dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/quote_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/tulia_white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/quote_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/tulia_white"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/message_image"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="@string/photo_message"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/audio_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/audio_play"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_audio_play_sent"
                    android:contentDescription="@string/voice_note_play"
                    android:padding="9dp"
                    android:src="@drawable/ic_play"
                    app:tint="@color/tulia_red_deep" />

                <ImageView
                    android:id="@+id/audio_wave"
                    android:layout_width="90dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_waveform"
                    app:tint="@color/tulia_white" />

                <TextView
                    android:id="@+id/audio_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textAppearance="@style/TextAppearance.Tulia.Caption"
                    android:textColor="@color/tulia_white_70" />
            </LinearLayout>

            <TextView
                android:id="@+id/message_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Tulia.Body"
                android:textColor="@color/tulia_white" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/edited_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="@string/chat_edited_label"
                    android:textAppearance="@style/TextAppearance.Tulia.Caption"
                    android:textColor="@color/tulia_white_70"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/message_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Tulia.Caption"
                    android:textColor="@color/tulia_white_70" />

                <ImageView
                    android:id="@+id/message_ticks"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/ticks_sent"
                    android:importantForAccessibility="yes"
                    android:src="@drawable/ic_done_all"
                    app:tint="@color/tulia_white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reaction_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:visibility="gone" />
        </LinearLayout>
    </com.tulia.app.ui.widget.SentBubbleLayout>

</LinearLayout>
