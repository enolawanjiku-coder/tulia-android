<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingStart="0dp"
    android:paddingEnd="48dp">

    <com.tulia.app.ui.widget.ReceivedBubbleLayout
        android:id="@+id/received_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/bubble_padding_h"
        android:paddingTop="@dimen/bubble_padding_v"
        android:paddingEnd="@dimen/bubble_padding_h"
        android:paddingBottom="7dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/quote_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_quote_received"
                android:orientation="vertical"
                android:paddingStart="11dp"
                android:paddingTop="3dp"
                android:paddingEnd="11dp"
                android:paddingBottom="3dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/quote_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/tulia_red"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/quote_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/tulia_ink"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/message_image"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="@string/photo_message"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/message_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Tulia.Body"
                android:textColor="@color/tulia_ink" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/edited_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="@string/chat_edited_label"
                    android:textAppearance="@style/TextAppearance.Tulia.Caption"
                    android:textColor="@color/tulia_dust"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/message_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Tulia.Caption"
                    android:textColor="@color/tulia_dust" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reaction_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:visibility="gone" />
        </LinearLayout>
    </com.tulia.app.ui.widget.ReceivedBubbleLayout>

</LinearLayout>
