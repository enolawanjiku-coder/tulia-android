<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tulia_blush" />
            <stroke
                android:width="2dp"
                android:color="@color/tulia_red" />
            <corners android:radius="@dimen/input_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tulia_blush" />
            <stroke
                android:width="2dp"
                android:color="@color/tulia_transparent" />
            <corners android:radius="@dimen/input_corner" />
        </shape>
    </item>
</selector>
